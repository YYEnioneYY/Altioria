generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  sessions AdminSession[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(80)
  nameRu      String   @map("name_ru") @db.VarChar(120)
  nameEn      String   @map("name_en") @db.VarChar(120)
  imagePath   String?  @map("image_path") @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isPublished, sortOrder])
  @@map("categories")
}

enum ProductPriceType {
  FIXED
  ON_REQUEST
}

enum ProductFileType {
  PDF
  MODEL_3D
}

model Product {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  slug String @unique @db.VarChar(120)

  nameRu String @map("name_ru") @db.VarChar(160)
  nameEn String @map("name_en") @db.VarChar(160)

  descriptionRu String @map("description_ru") @db.Text
  descriptionEn String @map("description_en") @db.Text

  materialsRu String? @map("materials_ru") @db.Text
  materialsEn String? @map("materials_en") @db.Text

  heightMm Int? @map("height_mm")
  widthMm  Int? @map("width_mm")
  depthMm  Int? @map("depth_mm")

  priceType     ProductPriceType @default(ON_REQUEST) @map("price_type")
  priceAmount   Decimal?         @map("price_amount") @db.Decimal(12, 2)
  priceCurrency String?          @map("price_currency") @db.VarChar(3)

  sortOrder   Int     @default(0) @map("sort_order")
  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images   ProductImage[]
  files    ProductFile[]
  variants ProductVariant[]

  @@index([categoryId, isPublished, sortOrder])
  @@map("products")
}

model ProductImage {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  imageKey String @unique @map("image_key") @db.VarChar(500)

  altRu String? @map("alt_ru") @db.VarChar(255)
  altEn String? @map("alt_en") @db.VarChar(255)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model ProductFile {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  type ProductFileType

  fileKey      String @unique @map("file_key") @db.VarChar(500)
  originalName String @map("original_name") @db.VarChar(255)
  mimeType     String @map("mime_type") @db.VarChar(150)
  sizeBytes    Int    @map("size_bytes")

  labelRu String? @map("label_ru") @db.VarChar(160)
  labelEn String? @map("label_en") @db.VarChar(160)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type, sortOrder])
  @@map("product_files")
}

model ProductVariant {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid

  slug String @db.VarChar(100)

  nameRu String @map("name_ru") @db.VarChar(160)
  nameEn String @map("name_en") @db.VarChar(160)

  descriptionRu String? @map("description_ru") @db.Text
  descriptionEn String? @map("description_en") @db.Text

  materialsRu String? @map("materials_ru") @db.Text
  materialsEn String? @map("materials_en") @db.Text

  heightMm Int? @map("height_mm")
  widthMm  Int? @map("width_mm")
  depthMm  Int? @map("depth_mm")

  priceType     ProductPriceType? @map("price_type")
  priceAmount   Decimal?          @map("price_amount") @db.Decimal(12, 2)
  priceCurrency String?           @map("price_currency") @db.VarChar(3)

  sortOrder   Int     @default(0) @map("sort_order")
  isPublished Boolean @default(false) @map("is_published")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  images ProductVariantImage[]
  files  ProductVariantFile[]

  @@unique([productId, slug])
  @@index([productId, isPublished, sortOrder])
  @@map("product_variants")
}

model ProductVariantImage {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  imageKey String @unique @map("image_key") @db.VarChar(500)

  altRu String? @map("alt_ru") @db.VarChar(255)
  altEn String? @map("alt_en") @db.VarChar(255)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, sortOrder])
  @@map("product_variant_images")
}

model ProductVariantFile {
  id        String @id @default(uuid()) @db.Uuid
  variantId String @map("variant_id") @db.Uuid

  type ProductFileType

  fileKey      String @unique @map("file_key") @db.VarChar(500)
  originalName String @map("original_name") @db.VarChar(255)
  mimeType     String @map("mime_type") @db.VarChar(150)
  sizeBytes    Int    @map("size_bytes")

  labelRu String? @map("label_ru") @db.VarChar(160)
  labelEn String? @map("label_en") @db.VarChar(160)

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, type, sortOrder])
  @@map("product_variant_files")
}
