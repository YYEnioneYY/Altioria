{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

    # Запрещаем индексировать служебные маршруты,
    # даже если поисковый робот не исполняет JavaScript.
    @nonIndexable path /admin /admin/* /admin-dashboard /admin-dashboard/* /api /api/*
    header @nonIndexable X-Robots-Tag "noindex, nofollow"

    # Динамический sitemap из опубликованного каталога.
    handle /sitemap.xml {
    	rewrite * /api/sitemap.xml
    	reverse_proxy backend:3000
    }

	# NestJS API
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Vite assets имеют hash в имени,
	# поэтому их можно кешировать надолго.
	@viteAssets path /assets/*
	header @viteAssets Cache-Control "public, max-age=31536000, immutable"

	# Известные маршруты React SPA.
    @spaRoutes path / /ru /en /ru/about /en/about /ru/products /en/products /ru/products/* /en/products/* /ru/contacts /en/contacts /ru/privacy-policy /en/privacy-policy /about /products /products/* /contacts /privacy-policy /admin/login /admin-dashboard /admin/categories /admin/products /admin/products/* /admin/help

    handle @spaRoutes {
    	root * /srv
    	try_files {path} /index.html
    	file_server
    }

    # Настоящие статические файлы:
    # изображения, robots.txt, favicon и assets.
    handle {
    	root * /srv
    	try_files {path} =404
    	file_server
    }

    # Для неизвестного адреса возвращаем index.html,
    # но сохраняем HTTP-статус 404.
    handle_errors {
    	@notFound expression {http.error.status_code} == 404

    	handle @notFound {
    		rewrite * /index.html
    		root * /srv
    		file_server
    	}
    }
}